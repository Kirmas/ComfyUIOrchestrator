# User-level unit (runs as keresh, NOT the orchestrator user) -- installed by
# install.sh into ~/.config/systemd/user/. See README.md for why the runner is
# a separate process from comfy-orchestrator-api at all.
[Unit]
Description=Comfy Orchestrator agent runner (Claude Code chat sessions)

[Service]
Type=simple
WorkingDirectory=%h/comfy-orchestrator/agent_runner
EnvironmentFile=%h/.config/comfy-agent-runner/env
ExecStart=%h/comfy-orchestrator/agent_runner/.venv/bin/uvicorn runner:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
